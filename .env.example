# Raymahomes — environment template (no secrets)
# Copy to Coolify / local env. Never commit real values.

# --- Mode / database ---
DATABASE_URL=postgresql://USER:PASSWORD@fleet-postgres:5432/raymahomes
POSTGRES_URL=
PG_POOL_MAX=10
PG_CONNECT_TIMEOUT_MS=10000
PG_STATEMENT_TIMEOUT_MS=30000
PG_QUERY_TIMEOUT_MS=30000
PGSSL=
NEXT_PUBLIC_USE_PLAIN_PG=true

# Shape-A shim: point at the app origin (not *.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=https://www.raymakitchenware.com
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-long-random-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-long-random-service-role-key
AUTH_JWT_SECRET=replace-with-long-random-jwt-secret
JWT_SECRET=
SUPABASE_JWT_SECRET=

# --- App ---
NEXT_PUBLIC_APP_URL=https://www.raymakitchenware.com
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# --- Local disk storage (replaces Supabase Storage) ---
STORAGE_ROOT=/data/raymahomes/uploads
STORAGE_PUBLIC_URL=https://www.raymakitchenware.com
STORAGE_SIGNING_SECRET=replace-with-long-random-signing-secret

# --- Moolre payments ---
MOOLRE_API_USER=
MOOLRE_API_PUBKEY=
MOOLRE_ACCOUNT_NUMBER=
MOOLRE_MERCHANT_EMAIL=info@raymakitchenware.com
MOOLRE_CALLBACK_SECRET=

# --- Moolre SMS ---
MOOLRE_SMS_API_KEY=
MOOLRE_API_KEY=
MOOLRE_SMS_SENDER_ID=RaymaKitchen
ADMIN_SMS_NUMBERS=

# --- Email (Resend) ---
RESEND_API_KEY=
EMAIL_FROM=Rayma Kitchenware <noreply@raymakitchenware.com>
ADMIN_EMAIL=info@raymakitchenware.com

# --- Admin bootstrap / cron ---
CREATE_ADMIN_SECRET=
ADMIN_PASSWORD=
CRON_SECRET=

# --- reCAPTCHA ---
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
